{
  "name": "@gpt-image-canvas/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "pnpm --filter @gpt-image-canvas/shared build && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "smoke:agent": "tsx src/smoke/agent-smoke.ts",
    "smoke:agent-generation-queue": "tsx src/smoke/agent-generation-queue-smoke.ts",
    "smoke:auth-registration-domain": "tsx src/smoke/auth-registration-domain-smoke.ts",
    "smoke:auth-registration-email-verification": "tsx src/smoke/auth-registration-email-verification-smoke.ts",
    "smoke:executor": "tsx src/smoke/agent-executor-smoke.ts",
    "smoke:generation-recovery": "tsx src/smoke/generation-recovery-smoke.ts",
    "smoke:generation-queue-observability": "tsx src/smoke/generation-queue-observability-smoke.ts",
    "smoke:generation-queue-observability:inline": "tsx src/smoke/generation-queue-observability-inline-smoke.ts",
    "smoke:generation-queue": "tsx src/smoke/generation-queue-smoke.ts",
    "smoke:planner": "tsx src/smoke/agent-planner-smoke.ts",
    "smoke:provider-config": "tsx src/smoke/provider-config-smoke.ts",
    "smoke:provider-config:mysql": "tsx src/smoke/provider-config-mysql-smoke.ts",
    "smoke:provider-retry": "tsx src/smoke/provider-retry-policy-smoke.ts",
    "smoke:provider-scheduler": "tsx src/smoke/provider-scheduler-smoke.ts",
    "smoke:redis-runtime": "tsx src/smoke/redis-runtime-smoke.ts",
    "smoke:security-hardening": "tsx src/smoke/security-hardening-smoke.ts",
    "typecheck": "pnpm --filter @gpt-image-canvas/shared build && tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@gpt-image-canvas/shared": "workspace:^",
    "@hono/node-server": "^2.0.0",
    "@langchain/anthropic": "^1.4.0",
    "@langchain/openai": "^1.4.5",
    "ali-oss": "^6.23.0",
    "better-sqlite3": "^12.9.0",
    "deepagents": "^1.10.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.2",
    "hono": "^4.12.23",
    "mysql2": "^3.15.3",
    "openai": "^6.34.0",
    "redis": "^5.12.1",
    "sharp": "^0.34.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0"
  }
}
